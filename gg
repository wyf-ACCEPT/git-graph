#!/bin/zsh
set -euo pipefail
APP_DIR="${0:A:h}"
BUN="${GIT_GRAPH_BUN:-}"
if [[ -z "$BUN" ]]; then
 for runtime in "$APP_DIR/.runtime/node_modules/.bin/bun" "$APP_DIR/../.runtime/node_modules/.bin/bun"; do
  if [[ -x "$runtime" ]]; then BUN="$runtime"; break; fi
 done
fi
if [[ -z "$BUN" ]]; then BUN="$(command -v bun || true)"; fi
PORT=""
repo=""
root="${PWD:A}"
action=start
explicit_root=false
usage(){ cat <<'USAGE'
Usage: gg [ROOT] [--repo NAME] [--port PORT]
       gg [ROOT] --status | --stop | --restart | --logs [N] | --help

The default ROOT is the current Git repository, or the current directory when
outside Git. gg discovers nested repositories and reuses one server per root.
Different roots use independent ports. Explicit --port pins an exact port.
The URL is copied to the clipboard. Ask the current Codex agent to open it in
the current conversation's right panel.

Examples:
  cd ~/src && gg
  gg ~/src --repo example-repository
  gg --status
USAGE
}
while (( $# )); do
 case "$1" in
  --help|-h) usage; exit 0;;
  --status) action=status;;
  --stop) action=stop;;
  --restart) action=restart;;
  --logs) action=logs; if (( $#>1 )) && [[ "$2" != -* ]]; then logs="$2"; shift; else logs=200; fi;;
  --repo) (( $#>1 )) || { print -u2 'gg: --repo needs a name'; exit 2; }; repo="$2"; shift;;
  --repo=*) repo="${1#*=}";;
  --port) (( $#>1 )) || { print -u2 'gg: --port needs a number'; exit 2; }; PORT="$2"; shift;;
  --port=*) PORT="${1#*=}";;
  -*) print -u2 "gg: unknown option $1"; exit 2;;
  *) root="${1:A}"; explicit_root=true;;
 esac
 shift
done
[[ -x "$BUN" ]] || { print -u2 "gg: missing local Bun runtime"; exit 1; }
[[ -d "$root" ]] || { print -u2 "gg: root is not a directory: $root"; exit 2; }
if [[ "$explicit_root" == false ]]; then
 git_root="$(git -C "$root" rev-parse --show-toplevel 2>/dev/null || true)"
 if [[ -n "$git_root" ]]; then root="${git_root:A}"; fi
fi
if [[ -n "$PORT" ]]; then
 [[ "$PORT" == <-> ]] && (( PORT > 0 && PORT < 65536 )) || { print -u2 'gg: invalid port'; exit 2; }
fi
cd "$APP_DIR"
if [[ "$action" == logs ]]; then repo="$logs"; fi
result="$(env NODE_ENV=production GIT_GRAPH_WORKSPACE_ROOT="$root" "$BUN" dist/server/cli.js workspace "$action" "$repo" "$PORT")"
if [[ "$action" != start && "$action" != restart ]]; then print -r -- "$result"; exit 0; fi
print -rn -- "$result" | pbcopy 2>/dev/null || true
print "gg: Git Graph ready at $result"
print "gg: URL copied; open it in the current conversation's right panel"
